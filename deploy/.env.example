# =============================================================================
# manawi-bandung — production environment
#
# Di server, file ini berada di /opt/manawi-bandung/.env (chmod 600, jangan di-commit).
#   scp deploy/.env.example deploy@<server>:/opt/manawi-bandung/.env
#
# VITE_GA_MEASUREMENT_ID dan VITE_WHATSAPP_NUMBER TIDAK diatur di sini:
# keduanya ditanam saat build time oleh GitHub Actions (Settings -> Variables).
# Mengubah nilainya membutuhkan rilis/tag baru.
# =============================================================================

# Release — ditulis otomatis oleh deploy.sh setiap rilis.
# Untuk rollback, isi tag sebelumnya (mis. 1.0.0 atau sha-xxxxxxx) lalu `docker compose up -d`.
MANAWI_WEB_IMAGE_TAG=

# Port loopback tujuan proxy host nginx. Harus sama dengan upstream di
# /etc/nginx/sites-available/manawi-bandung.conf.
APP_PORT=8700

TZ=Asia/Jakarta
